# ============================================================
# StallFront - all settings
#
# Nothing is required with Docker: the container generates the keys and,
# without DB_HOST, uses its own database. Each value can be given as an
# environment variable (Docker) or as a line in the .env file (/data/.env
# in Docker, the application folder on a shared hosting); environment
# variables take precedence.
# ============================================================

# ── Application ──────────────────────────────────────────────
# Public address without trailing slash. Used in email links and image URLs.
APP_URL=http://localhost:8080
APP_NAME=StallFront
# Language used when the browser language is not supported: en it es fr de pt nl pl
APP_LOCALE=en
# PHP time zone name, e.g. Europe/Rome, America/New_York
APP_TIMEZONE=UTC
# ISO 4217 currency code of the prices
APP_CURRENCY=EUR
APP_ENV=production
APP_DEBUG=false
# Generated automatically (Docker and web installer). Never share it.
APP_KEY=

# How scheduled tasks run: cron (a cron job every minute, Docker does it) or web (hostings without cron)
SCHEDULER_MODE=cron

# ── Database ─────────────────────────────────────────────────
# Docker: leave DB_HOST empty to use the embedded MariaDB.
# mysql (MySQL/MariaDB) | pgsql (PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=stallfront
DB_USERNAME=stallfront
DB_PASSWORD=

# ── Email ────────────────────────────────────────────────────
# smtp | sendmail (hosting's built-in email) | log (write emails to the log)
MAIL_MAILER=log
MAIL_HOST=
# 587 STARTTLS, 465 SSL (then MAIL_SCHEME=smtps)
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
# For MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i"

# Copy of every sent email in the mailbox "Sent" folder (IMAP over SSL)
MAIL_SENT_COPY=false
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=
MAIL_SENT_FOLDER=

# ── Browser notifications ────────────────────────────────────
# Generated automatically (Docker and web installer), or: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── WhatsApp mobile verification (optional) ────────────────
# Without these the verification runs in test mode. They can also be set from the seller panel.
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── Internals (defaults are fine) ───────────────────────────
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=daily
LOG_LEVEL=warning
# true on hostings that do not allow symbolic links (set by the installer)
PUBLIC_STORAGE_IN_PUBLIC=false
